# ========================================
# DocInsight Environment Configuration
# ========================================
# Copy this file to .env and update with your values
# NEVER commit .env to version control

# ===== Database Configuration =====
# Local Development (SQLite - default):
DATABASE_URL=sqlite:///./dev.db

# Production (PostgreSQL - Railway auto-provides):
# DATABASE_URL=postgresql://user:password@host:port/database
# Note: Railway automatically sets DATABASE_URL, no manual config needed

# ===== Security & Authentication =====
# CRITICAL: Generate secure key for production with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== Environment Mode =====
# Auto-detected based on DATABASE_URL (postgresql:// = production, sqlite:// = development)
# Override if needed:
# ENV=production
# ENV=development

# ===== CORS Origins =====
# Development: "*" allows all origins (default)
# Production: Comma-separated list of allowed frontend URLs
CORS_ORIGINS=*
# Production example:
# CORS_ORIGINS=https://your-frontend.railway.app,https://yourdomain.com

# ===== AI Model Configuration =====
SUMMARIZER_MODEL=google/flan-t5-base
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# ===== OCR Configuration =====
# Auto-detected based on OS. Override if needed:
# macOS (M1/M2): /opt/homebrew/bin/tesseract
# macOS (Intel): /usr/local/bin/tesseract  
# Linux/Railway: /usr/bin/tesseract
# TESSERACT_CMD=/usr/bin/tesseract

# ===== Web Search (Optional) =====
# Leave empty to use DuckDuckGo (default)
#BING_API_KEY=
