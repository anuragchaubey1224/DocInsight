# ========================================
# DocInsight Environment Configuration
# ========================================
# Copy this file to .env and update with your values
# NEVER commit .env to version control

# ===== Database Configuration =====
DATABASE_URL=sqlite:///./backend/app/data/docinsight.db

# ===== Security & Authentication =====
# Generate secure key with: openssl rand -hex 32
SECRET_KEY=your-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== File Storage Directories =====
UPLOAD_DIR=./backend/app/data/uploads
INDEX_DIR=./backend/app/data/index

# ===== AI Model Configuration =====
SUMMARIZER_MODEL=google/flan-t5-base
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# ===== OCR Configuration =====
# Adjust path based on your OS:
# macOS (M1/M2): /opt/homebrew/bin/tesseract
# macOS (Intel): /usr/local/bin/tesseract  
# Linux: /usr/bin/tesseract
TESSERACT_CMD=/opt/homebrew/bin/tesseract

# ===== Web Search (Optional) =====
# Leave empty to use DuckDuckGo (default)
#BING_API_KEY=
